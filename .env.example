# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# postgres://mr_garments_app:<password from D:\SDEC\pgdata\mr_garments_app.pw>@localhost:5432/<database>
# Neon (Connect, connection pooling off), with sslmode=verify-full in place of sslmode=require&channel_binding=require:
# postgresql://<role>:<password>@<endpoint-id>.<region>.aws.neon.tech/<database>?sslmode=verify-full
DATABASE_URL=postgres://mr_garments_app:<password>@localhost:5432/mr_garments_dev
# At least 32 random characters.
SESSION_SECRET=<at least 32 random characters>
# The frontend address. Requests that change data must come from it.
APP_ORIGIN=http://localhost:3000
# Development only: the password given to seeded users that have none. 8-128 characters, a number and a capital letter.
# Fill in yourself, or leave empty to set none.
SEED_DEV_PASSWORD=
